{
  "name": "scribix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run check-locales",
    "check-locales": "node scripts/check-locales.mjs",
    "test:video-tracking": "node --test scripts/test-video-tracking.mjs",
    "test:video-workspace": "node scripts/test-video-workspace-contracts.mjs",
    "test:video-export-monitor": "node --test scripts/test-video-export-monitor.mjs",
    "test:export-archive": "node --test scripts/export-archive.test.mjs",
    "test:render-scope": "node --test scripts/test-render-scope.mjs",
    "test:render-scheduling": "node --test scripts/test-render-scheduling.mjs",
    "test:ai-candidates": "node --test scripts/test-openai-candidates.mjs",
    "test:aai-completion": "node --test scripts/test-aai-completion.mjs",
    "prototype:video-workspace": "node scripts/video-workspace/ffmpeg-prototype.mjs",
    "test:video-preview": "node scripts/video-workspace/test-preview-render.mjs",
    "test:video-final": "node scripts/video-workspace/test-final-render.mjs",
    "test:video-consistency": "node scripts/video-workspace/test-presentation-consistency.mjs",
    "test:video-visual-parity": "node scripts/video-workspace/test-visual-parity.mjs",
    "test:video-security": "node scripts/video-workspace/test-security-controls.mjs",
    "benchmark:video-render": "node scripts/video-workspace/run-render-benchmark.mjs",
    "poc:cloudflare-video": "node scripts/video-workspace/cloudflare-container-poc.mjs",
    "poc:cloudflare-video:remote": "node scripts/video-workspace/run-cloudflare-container-remote-poc.mjs",
    "poc:smart-reframe": "node scripts/video-workspace/smart-reframe-poc.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "dev:video-workspace": "MINIFLARE_CONTAINER_EGRESS_IMAGE=cloudflare/proxy-everything:3cb1195 wrangler dev -c wrangler.jsonc -c wrangler.video-render.local.jsonc --persist-to .wrangler/state --port 3000",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "preview": "npm run check-locales && opennextjs-cloudflare build && opennextjs-cloudflare preview --remote",
    "deploy": "node scripts/deploy-production.mjs",
    "extension:local": "node scripts/build-extension.mjs chrome local",
    "extension:zip": "node scripts/build-extension.mjs chrome prod --zip",
    "extension:edge:local": "node scripts/build-extension.mjs edge local",
    "extension:edge:zip": "node scripts/build-extension.mjs edge prod --zip",
    "extension:firefox:local": "node scripts/build-extension.mjs firefox local",
    "extension:firefox:zip": "node scripts/build-extension.mjs firefox prod --zip",
    "extension:firefox:source": "node scripts/build-firefox-source.mjs",
    "extension:all:zip": "node scripts/build-extension.mjs all prod --zip",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply scribix-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply scribix-db --remote",
    "deploy:cleanup": "wrangler deploy -c wrangler.cleanup.jsonc",
    "deploy:video-render": "wrangler deploy -c wrangler.video-render.jsonc",
    "deploy:cloudflare-video-poc": "wrangler deploy -c wrangler.video-container-poc.jsonc --x-autoconfig=false",
    "test:free-quota": "node --test scripts/test-free-quota.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@paddle/paddle-js": "^1.6.4",
    "aws4fetch": "^1.0.20",
    "docx": "^9.6.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.11.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260701.1",
    "@opennextjs/cloudflare": "^1.19.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "5.8.3",
    "wrangler": "4.107.0"
  }
}

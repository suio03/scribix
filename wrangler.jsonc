/**
 * Cloudflare Workers config for Scribix (Next.js via @opennextjs/cloudflare).
 *
 * After running `wrangler d1 create scribix-db` and `wrangler r2 bucket create scribix-media`,
 * paste the database_id into d1_databases[0].database_id below.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scribix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  "observability": {
    "enabled": true
  },

  "secrets": {
    "required": [
      "ASSEMBLYAI_API_KEY",
      "AUTH_SECRET",
      "DISCORD_CHECKOUT_WEBHOOK_URL",
      "DISCORD_ERROR_WEBHOOK_URL",
      "DISCORD_FEEDBACK_WEBHOOK_URL",
      "GOOGLE_ID",
      "GOOGLE_SECRET",
      "OPENAI_API_KEY",
      "PADDLE_API_KEY",
      "PADDLE_WEBHOOK_SECRET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "VIDEO_WORKER_SIGNING_SECRET",
      "YOUTUBE_CAPTION_SERVICE_TOKEN",
      "CLIPFLIGHT_API_KEY"
    ]
  },

  "vars": {
    "AI_CLIPS_BATCH_ENABLED": "true",
    "CLIPFLIGHT_TIKTOK_PUBLISH_ENABLED": "true",
    "VIDEO_WORKSPACE_ROLLOUT_PERCENT": "100",
    "VIDEO_WORKSPACE_PILOT_USER_IDS": "",
    "NEXT_PUBLIC_APP_URL": "https://scribix.io",
    "NEXTAUTH_URL": "https://scribix.io",
    "AUTH_URL": "https://scribix.io",
    "EDGE_EXTENSION_ID": "nojojdfhlbfklhjekkbpccnoclogacfn",
    "ASSEMBLYAI_COMPLETION_MODE": "webhook",
    "ASSEMBLYAI_WEBHOOK_URL": "https://scribix.io/api/webhook/assemblyai",
    "YOUTUBE_CAPTION_SERVICE_URL": "https://yt-caption.scribix.io",
    "NEXT_PUBLIC_PADDLE_ENV": "production",
    "NEXT_PUBLIC_PADDLE_CLIENT_TOKEN": "live_7c94d1c1d9c14836a0180654f9f",
    "PADDLE_BASIC_MONTHLY_PRICE_ID": "pri_01ktevdswwy319f1dpqf3766v0",
    "PADDLE_BASIC_YEARLY_PRICE_ID": "pri_01ktevek8v7mwd4crg71sm9em9",
    "PADDLE_PRO_MONTHLY_PRICE_ID": "pri_01kya7274z7tj43c0c02vmytpp",
    "PADDLE_PRO_YEARLY_PRICE_ID": "pri_01kya739why91ah1mpc0vfcdsw",
    "PADDLE_HISTORICAL_PRO_MONTHLY_PRICE_ID": "pri_01ktevg56mngvqpbf0q1gna6b0",
    "PADDLE_HISTORICAL_PRO_YEARLY_PRICE_ID": "pri_01ktevh9r6vsvdx6v9ga70r1as",
    "PADDLE_V2_STARTER_MONTHLY_PRICE_ID": "pri_01m35vvz226a3de2cprphht0q1",
    "PADDLE_V2_STARTER_YEARLY_PRICE_ID": "pri_01m35vwy32ks3jz4k3mgfzdxvm",
    "PADDLE_V2_PRO_MONTHLY_PRICE_ID": "pri_01m35vy0nqcrdd6vg1rvx5ppxh",
    "PADDLE_V2_PRO_YEARLY_PRICE_ID": "pri_01m35vyq086jb3dmxem8q875vs",
    "PADDLE_V2_CHECKOUT_ENABLED": "false",
    "CLOUDFLARE_ACCOUNT_ID": "9955b1e01b98cb8e830f0543c4c002f2",
    "ADMIN_EMAILS": "laughinglyl90@gmail.com"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scribix-db",
      "database_id": "c031ef5c-899a-426a-897a-279e011be78d",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SCRIBIX_MEDIA",
      "bucket_name": "scribix-media",
      "remote": true
    }
  ],

  "queues": {
    "producers": [
      { "binding": "AI_CLIPS_QUEUE", "queue": "scribix-ai-clips" },
      {
        "binding": "VIDEO_RENDER_QUEUE",
        "queue": "scribix-video-render"
      }
    ]
  }
}

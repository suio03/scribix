{
  "manifest_version": 3,
  "name": "YouTube Transcript & Summary Generator",
  "description": "Generate YouTube transcripts on desktop watch pages, with AI summaries for Scribix Pro users.",
  "version": "0.1.1",
  "action": {
    "default_title": "YouTube Transcript & Summary Generator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://scribix.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://scribix.io/extension-login/complete*"],
      "js": ["login-complete.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css", "icons/icon-48.png"],
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scribix-video-container-poc",
  "main": "workers/video-container-poc.ts",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "VideoPocContainer",
      "image": "./containers/video-preview/Dockerfile.poc",
      "image_build_context": "./containers/video-preview",
      "max_instances": 3,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 6000
      },
      "ssh": {
        "enabled": false
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_POC",
        "class_name": "VideoPocContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "video-container-poc-v1",
      "new_sqlite_classes": ["VideoPocContainer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEO_POC_BUCKET",
      "bucket_name": "scribix-video-container-poc"
    }
  ]
}

/**
 * Scribix scheduled cleanup worker.
 * Deploy with: pnpm wrangler deploy -c wrangler.cleanup.jsonc
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scribix-cleanup",
  "main": "crons/cleanup-worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scribix-db",
      "database_id": "c031ef5c-899a-426a-897a-279e011be78d"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SCRIBIX_MEDIA",
      "bucket_name": "scribix-media"
    }
  ]
}

# Copy to .env.local and fill in. .env.local is gitignored.
# Mirror everything below into .dev.vars too (read by wrangler dev / opennextjs preview).
# See docs/manual-setup.md for where each value comes from.

# next-auth (Phase 1)
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=                   # generate with: openssl rand -base64 32
GOOGLE_ID=
GOOGLE_SECRET=

# AssemblyAI (Phase 2)
ASSEMBLYAI_API_KEY=
# Local server pulls results from AAI; no ngrok needed. Production uses webhook.
ASSEMBLYAI_COMPLETION_MODE=polling
# Only used with ASSEMBLYAI_COMPLETION_MODE=webhook (requires a public URL).
ASSEMBLYAI_WEBHOOK_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (AI summaries)
OPENAI_API_KEY=

# YouTube captions service (caption fetching runs outside Cloudflare/Next egress)
YOUTUBE_CAPTION_SERVICE_URL=https://yt-caption.scribix.io
YOUTUBE_CAPTION_SERVICE_TOKEN=

# R2 presign (Phase 2) — needed for direct browser uploads
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Video workspace final rendering
# Use the host URL so the local render container can call the app's internal API.
VIDEO_WORKER_SIGNING_SECRET=   # generate with: openssl rand -hex 32
SCRIBIX_INTERNAL_URL=http://host.docker.internal:3000
VIDEO_RENDER_MAX_CONTAINERS=1

# Paddle (Phase 4)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle price IDs — create one recurring price per tier × billing cycle in the
# Paddle dashboard, paste the pri_... ids here. Sandbox and prod use separate ids.
PADDLE_BASIC_MONTHLY_PRICE_ID=
PADDLE_BASIC_YEARLY_PRICE_ID=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_PRO_YEARLY_PRICE_ID=

# Admin / ops (Phase 6)
ADMIN_EMAILS=
DISCORD_WEBHOOK_URL=
DISCORD_FEEDBACK_WEBHOOK_URL=

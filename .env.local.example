# Copy to .env.local and fill in. .env.local is gitignored.

# next-auth
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=                   # generate with: openssl rand -base64 32
GOOGLE_ID=
GOOGLE_SECRET=

# AssemblyAI
ASSEMBLYAI_API_KEY=

# Creem
CREEM_API_KEY=
NEXT_PUBLIC_CREEM_ENV=test
CREEM_WEBHOOK_SECRET=

# Admin allowlist (comma-separated)
ADMIN_EMAILS=

# Optional
DISCORD_WEBHOOK_URL=

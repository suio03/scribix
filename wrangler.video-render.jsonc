{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scribix-video-render-dispatcher",
  "main": "workers/video-render-dispatcher.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "vars": {
    "SCRIBIX_INTERNAL_URL": "https://scribix.io",
    "VIDEO_RENDER_MAX_CONTAINERS": "3"
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scribix-db",
      "database_id": "c031ef5c-899a-426a-897a-279e011be78d"
    }
  ],

  "containers": [
    {
      "class_name": "VideoRenderContainer",
      "image": "./containers/video-preview/Dockerfile",
      "image_build_context": "./containers/video-preview",
      "max_instances": 3,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 6000
      },
      "ssh": {
        "enabled": false
      }
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_RENDER_CONTAINERS",
        "class_name": "VideoRenderContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "video-render-containers-v1",
      "new_sqlite_classes": ["VideoRenderContainer"]
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "VIDEO_RENDER_QUEUE",
        "queue": "scribix-video-render"
      }
    ],
    "consumers": [
      {
        "queue": "scribix-video-render",
        "max_batch_size": 3,
        "max_concurrency": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "scribix-video-render-dlq"
      }
    ]
  }
}
